#--------------------------------------------------------------------
# COMMS — Ecosistema de Comunicación Unificado
# Cubre tanto el Servicio de Mensajería (directo) como el Outbox de
# Notificaciones (asíncrono). Las claves de Rate Limit son globales
# y compartidas entre ambos subsistemas.
#--------------------------------------------------------------------

# --- CANALES POR SUBSISTEMA ---

# Canales para MessagingService (envíos inmediatos)
# Valores: email, push, telegram
# comms.messaging_channels = email,push,telegram

# Canales para NotificationDispatcher / Outbox (envíos asíncronos)
# Valores: inapp, email, push
# comms.notification_channels = inapp,email,push

# --- RATE LIMIT GLOBAL (compartido entre MessagingService y NotificationDispatcher) ---
# Clave en caché: {prefix}{canal}  (rl_msg_email | rl_msg_push | rl_msg_telegram)
# comms.rate_limit_cache_prefix = rl_msg_

# Email — límite para SMTP transaccional
# comms.rate_email_window = 3600   # segundos por ventana (default: 1 hora)
# comms.rate_email_max    = 100    # máximo de envíos por ventana

# Push FCM — FCM HTTP v1
# comms.rate_push_window  = 60     # segundos por ventana (default: 1 minuto)
# comms.rate_push_max     = 500    # máximo de envíos por ventana

# Telegram — Bot API
# comms.rate_telegram_window = 1   # segundos por ventana (default: 1 segundo)
# comms.rate_telegram_max    = 30  # máximo de envíos por ventana

# --- TELEGRAM BOT ---
